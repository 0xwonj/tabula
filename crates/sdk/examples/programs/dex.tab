use capability poseidon_hash;

program Dex

context {
  caller: u64;
  epoch: u64;
}

const DEFAULT_FEE_BPS: u64 = 30;

state {
  table pools(key pair: u64) {
    reserve_base: u64 @ssmc;
    reserve_quote: u64 @ssmc;
    fee_bps: u64 @ssmc;
    last_swap_out: u64 @ssmc;
  }
}

event SwapRecorded(pair: u64, trader: u64);

query pool_reserve(pair: u64, selector: u64) -> u64 {
  return select(selector == 0, pools[pair].reserve_base, pools[pair].reserve_quote);
}

query quote_exact_base_in(pair: u64, amount_in: u64) -> u64 {
  return amount_in * 2;
}

query configured_fee_bps(pair: u64) -> u64 {
  return select(pools[pair].fee_bps == 0, DEFAULT_FEE_BPS, pools[pair].fee_bps);
}

query last_swap_out(pair: u64) -> u64 {
  return pools[pair].last_swap_out;
}

query swap_digest(amount_in: u64) -> bytes32 {
  let digest = poseidon_hash(amount_in);
  return digest;
}

tx swap_exact_base_for_quote(pair: u64, quoted_out: u64) {
  pools[pair].last_swap_out = quoted_out;
  emit SwapRecorded(pair, caller);
  return;
}
